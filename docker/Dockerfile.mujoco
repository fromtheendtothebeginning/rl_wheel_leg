# MuJoCo 仿真 + 建模流水线（纯 CPU，镜像约 1.2 GB）
#
#   docker build -f docker/Dockerfile.mujoco -t kaiwu-robomaster:mujoco .
#   docker run --rm -v "$PWD":/workspace kaiwu-robomaster:mujoco scripts/run_mujoco.py --headless
#
# 代码在运行时挂载，所以改代码不用重建镜像；镜像里只有依赖。
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MUJOCO_GL=egl

# MuJoCo 的离屏渲染（--png）走 EGL/OSMesa；libglfw3 是 GUI viewer 用的，
# 容器里通常只看 PNG，所以不装。
RUN apt-get update && apt-get install -y --no-install-recommends \
        libegl1 libegl-mesa0 libgl1 libosmesa6 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

ENTRYPOINT ["python"]
CMD ["scripts/run_mujoco.py", "--headless"]
